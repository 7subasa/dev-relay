#!/usr/bin/env bash
# dev-relay の入口。サブコマンドごとに scripts/ のスクリプトを呼ぶ。
set -euo pipefail

DEV_RELAY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DEV_RELAY_ROOT

usage() {
  cat <<'EOF'
使い方: dev-relay <サブコマンド> [引数...]

  review design <設計書> [--focus S] [--repo DIR] [--reviewer ID] [--model M] [--effort E] [--out FILE] [--dry-run]
  review code [--uncommitted | --base BRANCH | --commit SHA] [--intent S] [--design FILE]
              [--focus S] [--repo DIR] [--extra [--exclude ID]] [--reviewer ID]
              [--model M] [--effort E] [--out FILE] [--dry-run]
                設計書または差分を、選ばれたレビュアーにレビューさせる
  doctor        道具の状態、設定、役割ごとに選ばれるレビュアーを表示する
  refresh check                 前回の記録と今を比べ、変化を表示する
  refresh save                  今の状態を記録し、確認した日を今日にする
  refresh notice [--hook]       知らせることがあれば1行表示する（SessionStart のフックが呼ぶ）
  smoke [--reviewer ID]... [--vendors <一覧|none>]
                本物のレビュアーを作り物の差分に対して動かし、出力形式を確かめる
  smoke check <結果ファイル>    結果ファイルが出力形式どおりかを調べる
  config metered [off|auto]
  config notice [on|off]
  config vendors [--user <一覧|none|ask> | --repo <一覧|none> | --repo --reset]
  config role <役割> [--from <ファイル> | --keep | --reset]
  config pr [--repo <on|off> | --repo --reset]
                利用者の設定を表示・変更する
  pr status [--base BRANCH]     PR を作る前提を確かめる（止める理由も表示する）
  pr recent                     題と本文の言語を決める材料（直近の PR の題、無ければコミットの題）を表示する
  pr draft-path                 下書きの本文を置くパスを表示する
  pr check FILE [--no-sections] [--title S]
                本文の形と、手元のパスや秘密の混入を調べる
  pr create --title S --body-file FILE [--base BRANCH] [--draft] [--no-sections] (--dry-run | --confirm VALUE)
                確認の値を出す（--dry-run）、または確認の値を受けて push と PR の作成をする（--confirm）
  pr feedback                   自分の PR に付いたレビューと CI を一覧にし、対応の前提を確かめる
  pr ci-log RUN_ID              CI の失敗したステップのログを保存する
  pr respond --plan FILE (--dry-run | --confirm VALUE)
                計画どおりに push・返信・まとめのコメント・CI の再実行をする（--dry-run が確認の値を出す）

各サブコマンドの詳細は dev-relay <サブコマンド> --help。
EOF
}

case "${1:-}" in
  ""|-h|--help) usage; exit 0 ;;
  review) shift; exec bash "$DEV_RELAY_ROOT/scripts/review.sh" "$@" ;;
  doctor) shift; exec bash "$DEV_RELAY_ROOT/scripts/doctor.sh" "$@" ;;
  config) shift; exec bash "$DEV_RELAY_ROOT/scripts/config.sh" "$@" ;;
  refresh) shift; exec bash "$DEV_RELAY_ROOT/scripts/refresh.sh" "$@" ;;
  pr) shift
    case "${1:-}" in
      feedback|ci-log|respond) exec bash "$DEV_RELAY_ROOT/scripts/pr-respond.sh" "$@" ;;
      *) exec bash "$DEV_RELAY_ROOT/scripts/pr.sh" "$@" ;;
    esac ;;
  smoke) shift; exec bash "$DEV_RELAY_ROOT/scripts/smoke.sh" "$@" ;;
  *) echo "error: 知らないサブコマンドです: $1" >&2; usage >&2; exit 1 ;;
esac
